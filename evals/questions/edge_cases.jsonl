# Edge cases: ambiguous input, no data available, forced tool failures.
{"id": "edge-001", "question": "What's the on-time rate for FlyZ Airlines from ORD?", "expected_tools": ["flight_data_query"], "rubric_focus": "FlyZ is a fictional airline; agent should report no matching data, not invent a number"}
{"id": "edge-002", "question": "Are there any current NOTAMs for KORD?", "expected_tools": ["notam_lookup"], "forced_tool_failures": ["notam_lookup"], "expected_no_fabrication": true, "ae_id": "AE2", "rubric_focus": "NOTAM tool unavailable; agent must acknowledge gap and NOT invent NOTAM identifiers like '!ORD 12/345'"}
{"id": "edge-003", "question": "What's the weather at KORD in 2050?", "expected_tools": ["weather_lookup"], "rubric_focus": "out-of-range forecast horizon; agent should decline cleanly"}
{"id": "edge-004", "question": "Get me delay statistics for flights between Yreka, CA and Pago Pago.", "expected_tools": ["flight_data_query"], "rubric_focus": "airports outside top-50; agent should report no-data and clarify scope"}
{"id": "edge-005", "question": "What's the cancellation rate for the route ORD to LGA from January 1900 to today?", "expected_tools": ["flight_data_query"], "rubric_focus": "date window extends before loaded data; agent should clarify the actual window"}
{"id": "edge-006", "question": "What does the AIM say about quantum drive failure procedures?", "expected_tools": ["corpus_search"], "rubric_focus": "no relevant content in AIM; agent should report low-confidence retrieval rather than fabricate"}
{"id": "edge-007", "question": "Tell me about KXYZ.", "expected_tools": ["weather_lookup"], "rubric_focus": "non-existent ICAO; agent handles upstream error gracefully"}
{"id": "edge-008", "question": "How does today's weather at ORD compare to yesterday's?", "expected_tools": ["weather_lookup"], "rubric_focus": "weather tool only returns current; agent should explain it can fetch current but not historical METAR"}
{"id": "edge-009", "question": "Pull all NOTAMs for KSFO from last August.", "expected_tools": ["notam_lookup"], "rubric_focus": "NOTAM tool returns current only; agent should explain this limit"}
{"id": "edge-010", "question": "ORD on-time rate?", "expected_tools": ["flight_data_query"], "rubric_focus": "ambiguous - which time window? Agent should ask a clarifying question OR pick a reasonable default and disclose"}
